      "boundElements": [],
      "updated": 1789267415061,
      "link": null,
      "locked": false,
      "text": "this ordering also serves as a guide to users\n- first input account balances\n- then budget from what you already have\n  - not based on income\n- then note down income transactions\n- expenses = income - net change (per month)\n- then input money that you are owed",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this ordering also serves as a guide to users\n- first input account balances\n- then budget from what you already have\n  - not based on income\n- then note down income transactions\n- expenses = income - net change (per month)\n- then input money that you are owed",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
