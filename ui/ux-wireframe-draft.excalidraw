      "boundElements": null,
      "updated": 1789240631628,
      "link": null,
      "locked": false,
      "text": "owed\n- keep track of money you are owed\n- that is money people owe you\n- money that you owe others should instead \n  - before return, budgeted\n  - on return, tracked in an account transaction\n- useful to remind you not to forget money\n- also useful reference for budgeting",
      "fontSize": 16.051273321670372,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "owed\n- keep track of money you are owed\n- that is money people owe you\n- money that you owe others should instead \n  - before return, budgeted\n  - on return, tracked in an account transaction\n- useful to remind you not to forget money\n- also useful reference for budgeting",
      "autoResize": true,
      "lineHeight": 1.25
